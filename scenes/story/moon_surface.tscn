; ─── Sky / Environment ─────────────────────────────────────────────────────
; No atmosphere → pitch-black sky, only direct sunlight.
[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_top_color    = Color(0.0008, 0.0008, 0.001, 1)
sky_horizon_color= Color(0.003, 0.003, 0.005, 1)
ground_bottom_color   = Color(0.0005, 0.0005, 0.001, 1)
ground_horizon_color  = Color(0.002, 0.002, 0.004, 1)
sun_angle_max    = 3.0

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env"]
background_mode      = 2
sky                  = SubResource("Sky")
ambient_light_source = 3
ambient_light_color  = Color(0.06, 0.06, 0.07, 1)
ambient_light_energy = 0.10
glow_enabled         = true
glow_intensity       = 0.30
glow_strength        = 0.8
glow_bloom           = 0.06
dof_blur_near_enabled= false
fog_enabled          = false
dof_blur_far_enabled = false
ssr_enabled          = false
ssao_enabled         = false
ssil_enabled         = false
sdfgi_enabled        = false

; ─── Terrain Mesh ───────────────────────────────────────────────────────────
; FLAT lunar plain (the spherical moon was fragile / things floated). Large
; enough to fill the horizon; craters + rocks are scattered on top at y=0.
[sub_resource type="PlaneMesh" id="Mesh_terrain"]
size = Vector2(700, 700)
subdivide_width = 24
subdivide_depth = 24

; ─── Ground Physics (flat box, top face at y = 0) ────────────────────────────
[sub_resource type="BoxShape3D" id="Shape_ground"]
size = Vector3(700, 2, 700)

; ─── Moon surface material ───────────────────────────────────────────────────
; Lightweight StandardMaterial3D (no heavy shader / large textures) so the Moon
; ALWAYS renders on the mobile renderer. The Sun + procedural rock/crater scatter
; provide the surface detail.
[sub_resource type="StandardMaterial3D" id="Mat_moon"]
albedo_color = Color(0.52, 0.52, 0.55, 1)
metallic = 0.0
roughness = 0.96
specular_mode = 1
ao_light_affect = 0.5

; ─── Earth (visible in the black sky) ───────────────────────────────────
[sub_resource type="SphereMesh" id="Mesh_earth"]
radius = 45.0
height = 90.0
radial_segments = 32
rings = 16

[sub_resource type="StandardMaterial3D" id="Mat_earth"]
albedo_color          = Color(0.15, 0.35, 0.70, 1)
emission_enabled      = true
emission              = Color(0.20, 0.45, 0.85, 1)
emission_energy_multiplier = 0.8
roughness             = 0.7

; ─── Scene Graph ───────────────────────────────────────────────────────────
[node name="MoonSurface" type="Node3D"]
script = ExtResource("1_moon")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

